{
  "schema": "sourcelore-ec-gold/1",
  "note": "手工构造的离线 gold 集。预期由人工依据题面规则写入，不由裁决器生成。",
  "cases": [
    {"id": "G01", "expected": "supported",
     "basis": "COMPLETE 快照 + 同仓库同 Commit 同路径的 OBSERVED_PRESENT → 命题'存在'成立",
     "scenario": "present_claim_exists"},
    {"id": "G02", "expected": "supported",
     "basis": "COMPLETE 快照 + 同范围 OBSERVED_ABSENT → 命题'不存在'成立",
     "scenario": "absent_claim_not_exists"},
    {"id": "G03", "expected": "refuted",
     "basis": "PRESENT 观察直接反驳'不存在'命题",
     "scenario": "present_refutes_not_exists"},
    {"id": "G04", "expected": "refuted",
     "basis": "COMPLETE 的 ABSENT 观察直接反驳'存在'命题",
     "scenario": "complete_absent_refutes_exists"},
    {"id": "G05", "expected": "insufficient_evidence",
     "basis": "无任何 Fact → 缺证明，绝不等于反证",
     "scenario": "no_facts"},
    {"id": "G06", "expected": "insufficient_evidence",
     "basis": "证据属于另一 Commit → 版本不匹配，不能借用来裁决",
     "scenario": "wrong_commit"},
    {"id": "G07", "expected": "insufficient_evidence",
     "basis": "证据属于另一仓库 → 身份不匹配",
     "scenario": "wrong_repository"},
    {"id": "G08", "expected": "insufficient_evidence",
     "basis": "PARTIAL 快照未命中 → UNKNOWN 未入库，不能证明不存在",
     "scenario": "partial_not_covering"},
    {"id": "G09", "expected": "supported",
     "basis": "PARTIAL 但确有真实存在条目 → 可支持'存在'，须带局部限制",
     "scenario": "partial_local_present"},
    {"id": "G10", "expected": "insufficient_evidence",
     "basis": "事实内容哈希被篡改 → 来源完整性失败，不能产生任何结论",
     "scenario": "corrupted_evidence"},
    {"id": "G11", "expected": "insufficient_evidence",
     "basis": "同范围出现 PRESENT 与 ABSENT 互相矛盾 → 保留冲突诊断，不强行裁决",
     "scenario": "conflicting_evidence"},
    {"id": "G12", "expected": "insufficient_evidence",
     "basis": "不支持的命题类型 → 显式拒绝，不得套用路径规则",
     "scenario": "unsupported_type"},
    {"id": "G13", "expected": "insufficient_evidence",
     "basis": "引用指向不存在的 fact → 证据链断了",
     "scenario": "missing_reference"},
    {"id": "G14", "expected": "insufficient_evidence",
     "basis": "事实路径与命题路径不同 → 不能张冠李戴",
     "scenario": "path_mismatch"}
  ]
}
